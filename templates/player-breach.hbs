{{#unless blocked}}
<div class="hbl-wrap hbl-player-wrap">
  <header class="hbl-header">
    <div>
      <h2>{{puzzle.name}}</h2>
      <p>Actor: {{actorName}} {{#if gmPreview}}<span class="hbl-preview-badge">GM PREVIEW — ROLE LOCK BYPASSED</span>{{else}}{{#if isNetrunner}}<span class="hbl-role-ok">NETRUNNER VERIFIED</span>{{/if}}{{/if}}</p>
      <p class="hbl-run-status">Sequences cracked: <b>{{solvedCount}}</b> / {{puzzle.sequences.length}} — one secured sequence is partial success; all sequences is full success.</p>
    </div>
    <div class="hbl-clock">
      <span><span class="hbl-timer">{{timerDisplay}}</span>{{#if puzzle.timerSeconds}}s{{/if}}</span>
      <small class="hbl-timer-state">{{#if timerStarted}}ACTIVE{{else}}STARTS ON FIRST HEX{{/if}}</small>
    </div>
  </header>

  {{#if gmPreview}}
  <section class="hbl-panel hbl-gm-preview-note">
    <i class="fas fa-eye"></i>
    <span><b>GM Preview only.</b> Bound Tiles and normal module calls remain locked to verified Netrunner Actors.</span>
  </section>
  {{/if}}

  <section class="hbl-panel hbl-reset-warning {{#if resetUsed}}spent{{/if}}">
    <i class="fas fa-exclamation-triangle"></i>
    <div>
      <b>Emergency Reset: one use only.</b>
      <p>It rebuilds the matrix and clears the active buffer. Once used, the remaining timer is cut in half and the reset is permanently recorded in chat for this run. Previously cracked sequences remain secured.</p>
    </div>
  </section>

  <section class="hbl-panel hbl-buffer-panel">
    <label>Buffer</label>
    <div class="hbl-buffer">
      {{#each buffer}}<span class="{{#if this}}filled{{/if}}">{{this}}</span>{{/each}}
    </div>
  </section>

  <section class="hbl-play-area">
    <div class="hbl-matrix" style="--hbl-cols: {{puzzle.gridSize}};">
      {{#each matrixRows as |row|}}
        {{#each row as |cell|}}
          <button type="button" class="hbl-cell {{#if cell.clicked}}clicked{{/if}} {{#if cell.allowed}}allowed{{/if}}" data-r="{{cell.r}}" data-c="{{cell.c}}">{{cell.value}}</button>
        {{/each}}
      {{/each}}
    </div>

    <aside class="hbl-sequences">
      <h3>Sequences</h3>
      {{#each puzzle.sequences as |seq|}}
        <div class="hbl-seq {{#if seq.solved}}solved{{/if}}">
          <b>{{seq.label}}</b>
          <div class="hbl-code-row">
            {{#each seq.code}}<span>{{this}}</span>{{/each}}
          </div>
          <div class="hbl-player-payloads">
            {{#if seq.eurobucks}}<small><i class="fas fa-coins"></i> {{seq.eurobucks}}eb</small>{{/if}}
            {{#if seq.rewardUuid}}<small title="{{seq.rewardUuid}}"><i class="fas fa-box-open"></i> Item: {{#if seq.rewardName}}{{seq.rewardName}}{{else}}Loaded Item Payload{{/if}}</small>{{/if}}
            {{#if seq.rollTableRef}}<small title="{{seq.rollTableRef}}"><i class="fas fa-list-ol"></i> Data: {{#if seq.rollTableName}}{{seq.rollTableName}}{{else}}Loaded Data RollTable{{/if}}</small>{{/if}}
          </div>
        </div>
      {{/each}}
    </aside>
  </section>

  <footer class="hbl-footer">
    <button type="button" data-action="clear" {{#unless resetAvailable}}disabled{{/unless}}>{{resetLabel}}</button>
    <button type="button" data-action="complete" {{#unless canComplete}}disabled{{/unless}}>Complete Breach</button>
    <button type="button" data-action="close">Close</button>
  </footer>
</div>
{{/unless}}
