<div class="hbl-wrap hbl-picker-wrap">
  <header class="hbl-header">
    <div>
      <h2>{{label}} Browser</h2>
      <p>Search world documents and every compatible compendium pack.</p>
    </div>
    <span class="hbl-picker-count">0 shown / {{total}} indexed</span>
  </header>

  <section class="hbl-panel">
    <label>Search</label>
    <input name="pickerSearch" type="search" placeholder="{{placeholder}}" autofocus />
  </section>

  <section class="hbl-picker-results"></section>
</div>
